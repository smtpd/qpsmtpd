#!perl -w

use strict;
use warnings;

use Qpsmtpd::Address;
use Qpsmtpd::Constants;

my $test_email = 'user@example.com';

sub register_tests {
    my $self = shift;

    my %args = ( );
    $self->register( $self->qp, reject => 0 );

    $self->register_test('test_populate_invalid_networks');
    $self->register_test('test_mx_ipv6_only');
    $self->register_test('test_mx_address_resolves');
    $self->register_test('test_get_host_records');
    $self->register_test('test_get_and_validate_mx');
    $self->register_test('test_check_dns');
    $self->register_test('test_hook_mail');
}

sub test_hook_mail {
    my $self = shift;

    my $transaction = $self->qp->transaction;
    my $address = Qpsmtpd::Address->new('remote@example.com');
    $transaction->sender($address);

    my $sender = $transaction->sender;
    $sender->host('perl.com');

    ok( $self->hook_mail( $transaction, $sender ) );
    ok( $self->hook_mail( $transaction, $sender ) );

    # a valid path with no domain to resolve
    $sender = Qpsmtpd::Address->new('<postmaster>');
    $self->{_args}{reject} = 1;
    $self->{_args}{reject_type} = 'soft';
    my ($r) = $self->hook_mail( $transaction, $sender );
    ok( $r == DENYSOFT, "($r)");

    $self->{_args}{reject_type} = 'hard';
    ($r) = $self->hook_mail( $transaction, $sender );
    ok( $r == DENY, "($r)");
}

sub test_check_dns {
    my $self = shift;

    my $transaction = $self->qp->transaction;
    ok( ! $self->check_dns( '', $transaction ) );
    ok( $self->check_dns( 'perl.com', $transaction ) );
}

sub test_get_and_validate_mx {
    my $self = shift;
    my $transaction = $self->qp->transaction;

    ok( scalar $self->get_and_validate_mx( 'perl.com', $transaction ) );

    ok( ! scalar $self->get_host_records( 'fake-domain-name-for-test.com', $transaction ) );
}

sub test_get_host_records {
    my $self = shift;
    my $transaction = $self->qp->transaction;

    ok( scalar $self->get_host_records( 'perl.com', $transaction ) );
    ok( ! scalar $self->get_host_records( 'fake-domain-name-for-test.com', $transaction ) );
}

sub test_mx_address_resolves {
    my $self = shift;

    my $fromhost = 'perl.com';

    ok( $self->mx_address_resolves('mail.perl.com', $fromhost) );
    ok( ! $self->mx_address_resolves('no-such-mx.perl.com', $fromhost) );
}

sub test_populate_invalid_networks {
    my $self = shift;

    $self->mock_config(invalid_resolvable_fromhost => '');
    $self->populate_invalid_networks();
    ok( $self->ip_is_valid('10.9.8.7'), 'no blocks, valid' );

    $self->unmock_config();
    $self->populate_invalid_networks();
    ok( ! $self->ip_is_valid('10.9.8.7'), 'in 10.0.0.0/8' );
    ok( $self->ip_is_valid('192.0.2.1'), 'IPv4, valid' );
    ok( ! $self->ip_is_valid('fe80::1'), 'in fe80::/10' );
    ok( ! $self->ip_is_valid('::1'), 'IPv6 loopback' );
    ok( $self->ip_is_valid('2001:db8::25'), 'IPv6, valid' );
}

sub test_mx_ipv6_only {
    my $self = shift;

    my @warnings;
    local $SIG{__WARN__} = sub { push @warnings, @_ };
    no warnings 'redefine';
    local *Qpsmtpd::Base::resolve_a = sub { return };
    local *Qpsmtpd::Base::resolve_aaaa = sub {
        return $_[1] eq 'mx.example.com' ? '2001:db8::25' : 'fe80::25';
    };

    $self->populate_invalid_networks();
    ok( $self->mx_address_resolves('mx.example.com', 'example.com'),
        'an MX with only an AAAA record resolves' );
    ok( ! $self->mx_address_resolves('mx.example.net', 'example.net'),
        'an MX whose AAAA record is link-local does not' );
    is_deeply( \@warnings, [], 'without warnings' );
}
