#!perl -w

use strict;
use English qw/-no_match_vars/;

use Mail::Header;
use Qpsmtpd::Constants;

use lib 't';
use Test::FakeResolver;

# Mail::DKIM looks keys up with send(), which, unlike query(), also returns a
# packet for NXDOMAIN and other errors, with the error as its rcode
package Test::FakeResolver::Send {
    our @ISA = ('Test::FakeResolver');
    sub send {
        my ($self, $name, $type) = @_;
        my $packet = $self->query($name, $type);
        return $packet if $packet;
        $packet = Net::DNS::Packet->new($name, $type);
        $packet->header->rcode($self->errorstring);
        return $packet;
    }
}

sub register_tests {
    my $self = shift;

    eval 'use Mail::DKIM::Signer; use Mail::DKIM::PrivateKey; use Crypt::OpenSSL::RSA; 1'
      or do {
        warn "unable to load Mail::DKIM, skipping dkim tests\n";
        return;
      };

    $self->register_test('_validate_immune');
}

# a message signed for example.com, and the TXT record that publishes its key
sub _signed_message {
    my $rsa = Crypt::OpenSSL::RSA->generate_key(1024);
    my $signer = Mail::DKIM::Signer->new(
        Algorithm => 'rsa-sha256',
        Method    => 'relaxed',
        Domain    => 'example.com',
        Selector  => 's1',
        Key       => Mail::DKIM::PrivateKey->load(Cork => $rsa),
    );
    my @header = (
        'From: sender@example.com',
        'To: rcpt@example.net',
        'Subject: dkim test',
        'Message-ID: <dkim-test@example.com>',
    );
    $signer->PRINT("$_\015\012") for @header, '', 'test message body';
    $signer->CLOSE;

    (my $pub = $rsa->get_public_key_x509_string) =~ s/-----[^-]+-----|\s//g;
    return ([ $signer->signature->as_string, @header ], "v=DKIM1; k=rsa; p=$pub");
}

sub _validate_immune {
    my $self = shift;

    my ($header, $txt) = $self->_signed_message();
    my (undef, $other_txt) = $self->_signed_message();    # a different key
    my $key = 's1._domainkey.example.com';

    my @cases = (
        # label, immune, DNS data for the key, expected rc, expected dkim_result
        [ 'immune, valid signature', 1,
          { $key => {TXT => [$txt]} }, DECLINED, 'pass' ],
        [ 'immune, bad signature: recorded, not rejected', 1,
          { $key => {TXT => [$other_txt]} }, DECLINED, 'fail' ],
        [ 'not immune, valid signature', 0,
          { $key => {TXT => [$txt]} }, DECLINED, 'pass' ],
        [ 'not immune, bad signature: rejected', 0,
          { $key => {TXT => [$other_txt]} }, DENY, 'fail' ],
    );

    $self->qp->connection->relay_client(0);
    $self->qp->transaction->notes('whitelistsender', undef);

    foreach my $case (@cases) {
        my ($label, $immune, $zone, $expect_rc, $expect_result) = @$case;

        Mail::DKIM::DNS::resolver(Test::FakeResolver::Send->new(%$zone));
        $self->qp->connection->notes('whitelisthost', $immune ? 1 : undef);
        $self->connection->notes('dkim_result',   undef);
        $self->connection->notes('dkim_verifier', undef);

        my $t = $self->qp->reset_transaction;
        $t->header(Mail::Header->new([ map {"$_\n"} @$header ],
                                     Modify => 0, MailFrom => 'COERCE'));
        # as in a real transaction, the body starts with the blank line
        $t->body_write("\015\012test message body\015\012");

        my ($rc) = $self->data_post_handler($t);
        cmp_ok($rc, '==', $expect_rc, "$label, rc");
        is($self->connection->notes('dkim_result'), $expect_result,
           "$label, dkim_result");
        isa_ok($self->connection->notes('dkim_verifier'), 'Mail::DKIM::Verifier',
               "$label, dkim_verifier note");
        like($t->notes('authentication_results') // '', qr/\bdkim=\Q$expect_result\E\b/,
             "$label, Authentication-Results");
    }

    $self->qp->connection->notes('whitelisthost', undef);
    Mail::DKIM::DNS::resolver(undef);
}
