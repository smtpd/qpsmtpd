#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

PKGDIR    = debian/qpsmtpd
PLUGINDIR = $(PKGDIR)/usr/share/qpsmtpd/plugins
ETCDIR    = $(PKGDIR)/etc/qpsmtpd

# qpsmtpd 0.94 dropped the check_ prefix from several plugins.  Ship thin
# wrappers under the old names so that configurations predating the rename
# keep working; see debian/README.check_plugins.  Format: <old>:<new>
LEGACY_PLUGINS = \
	check_badmailfrom:badmailfrom \
	check_badrcptto:badrcptto \
	check_earlytalker:earlytalker \
	check_loop:loop \
	check_relay:relay \
	check_spamhelo:helo

%:
	dh $@

override_dh_auto_install:
	dh_auto_install
	# The toplevel qpsmtpd script needs tcpserver, which is not in Debian;
	# this package uses qpsmtpd-forkserver instead.
	rm -f $(PKGDIR)/usr/bin/qpsmtpd
	# pf2qp.pl only generates Qpsmtpd::Postfix::Constants upstream
	rm -f $(PKGDIR)/usr/share/perl5/Qpsmtpd/Postfix/pf2qp.pl
	# start helper for qpsmtpd.service
	install -D -m 0755 debian/qpsmtpd-service \
		$(PKGDIR)/usr/libexec/qpsmtpd/qpsmtpd-service
	# configuration; permissions on the spool/state dirs are applied by
	# postinst via dpkg-statoverride
	install -d $(ETCDIR)
	cp -a debian/etc/. $(ETCDIR)/
	# plugins
	install -d $(PLUGINDIR)
	cp -a plugins/. $(PLUGINDIR)/
	set -e; for p in $(LEGACY_PLUGINS); do \
		sed -e "s/@OLD@/$${p%%:*}/g" -e "s/@NEW@/$${p##*:}/g" \
			debian/check-plugin-wrapper.in > $(PLUGINDIR)/$${p%%:*}; \
	done

# debian/qpsmtpd.service links to the upstream unit; the Debian specifics
# go into a drop-in next to wherever dh_installsystemd put the unit.
override_dh_installsystemd:
	dh_installsystemd
	set -e; unit=$$(find $(PKGDIR) -path '*/systemd/system/qpsmtpd.service'); \
	test -n "$$unit"; \
	install -D -m 0644 debian/systemd/debian.conf $$unit.d/debian.conf

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md
