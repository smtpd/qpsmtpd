#!perl -w

=head1 NAME

rhsbl - handle RHSBL lookups

=head1 DESCRIPTION

Pluging that checks the host part of the sender's address against a
configurable set of RBL services.

=head1 CONFIGURATION

This plugin reads the lists to use from the rhsbl_zones configuration file,
one domain blocklist (RFC 5782) per line, checked in order:

  dbl.spamhaus.org

A sender's domain is listed when the zone has an A record in 127.0.0.0/8
for it. The rejection gives the zone's TXT record as the reason. To give
your own instead, add it after whitespace:

  dbl.spamhaus.org is listed in the Spamhaus DBL

An answer of 127.255.255.252, .254 or .255 is an error report (see
L<dnsbl>). It is logged, and the sender is not rejected.

=cut

use strict;
use warnings;

use Qpsmtpd::Constants;

sub register {
    my ($self, $qp) = (shift, shift);

    if (@_ == 1) {
        $self->legacy_positional_args(@_);
    }
    else {
        $self->{_args} = {@_};
    }

    $self->{_args}{reject} = 1 if !defined $self->{_args}{reject};
    $self->{_args}{reject_type} ||= 'perm';
}

sub legacy_positional_args {
    my ($self, $denial) = @_;

    if (defined $denial && $denial =~ /^disconnect$/i) {
        $self->{_args}{reject_type} = 'disconnect';
    }
    else {
        $self->{_args}{reject_type} = 'perm';
    }
}

sub hook_mail {
    my ($self, $transaction, $sender, %param) = @_;

    return DECLINED if $self->is_immune();

    if ($sender->format eq '<>') {
        $self->log(LOGINFO, 'pass, null sender');
        return DECLINED;
    }

    my $host = $sender->host;
    if ($host !~ /^[a-z0-9.-]+$/i) {
        $self->log(LOGINFO, "skip, $host is not an ASCII domain");
        return DECLINED;
    }

    my @zones = $self->populate_zones() or return DECLINED;

    for (@zones) {
        my ($zone, $message) = @$_;
        my $result = $self->dnsbl_lookup("$host.$zone") or next;
        if ($result->{error}) {
            $self->log(LOGERROR, "skip, $result->{error}");
            next;
        }

        my $reason = $message // $result->{reason};
        $reason = "listed by $zone" if !length $reason;
        return $self->get_reject("Mail from $host rejected: $reason", $zone);
    }

    $self->log(LOGINFO, "pass");
    return DECLINED;
}

sub populate_zones {
    my $self = shift;

    my @zones =
      map { [split /\s+/, $_, 2] } $self->qp->config('rhsbl_zones');
    $self->log(LOGINFO, 'pass, no zones') if !@zones;
    return @zones;
}
