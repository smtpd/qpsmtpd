#!perl -w

=head1 NAME

milter

=head1 DESCRIPTION

This plugin allows you to attach to milter filters (yes, those written for
sendmail) as though they were qpsmtpd plugins.

It speaks milter protocol version 6, the version of sendmail 8.14+ and
Postfix 2.6+, and also works with milters that negotiate an older version.
Rspamd, OpenDKIM, OpenDMARC, ClamAV-milter and other libmilter filters are
supported.

=head1 CONFIG

It takes two required parameters - a milter name (for logging) and the
socket to connect to:

  milter rspamd 11332
  milter rspamd rspamd.example.com:11332
  milter rspamd [::1]:11332
  milter clamav unix:/var/run/clamav/clamav-milter.sock

A bare port connects to 127.0.0.1. The Postfix forms C<inet:host:port> and
C<unix:/path> are accepted.

List the plugin before your queue plugin, so that a message the milter
asks to discard is never queued.

=head2 timeout

Seconds to wait for each read from or write to the milter. Default: 30.

  milter rspamd 11332 timeout 10

=head1 BEHAVIOR

The milter's reply to each SMTP command is honored: reject and tempfail
replies (with the milter's custom reply text, if any) deny the command,
accept stops consulting the milter for the rest of the message (or the
connection, when given at connect or HELO), and discard accepts the message
without queuing it.

At the end of the message the milter may add, insert, change and delete
headers, replace the body, add and delete recipients and change the sender.

qpsmtpd has no hold queue. A quarantine request is logged and stored in the
C<milter_quarantine> transaction note, and the message is delivered.

If the milter cannot be reached, or fails mid-conversation, the error is
logged and mail flows on without it for the rest of the connection.

=head1 SEE ALSO

L<Qpsmtpd::Milter>, L<https://github.com/smtpd/qpsmtpd/issues/329>

=cut

use strict;
use warnings;

use Qpsmtpd::Address;
use Qpsmtpd::Constants;
use Qpsmtpd::Milter;

sub register {
    my ($self, $qp, $name, $socket, %args) = @_;

    die "usage: milter <name> <socket> [timeout <seconds>]\n"
      if !defined $socket;
    for my $key (keys %args) {
        die "milter: unknown option '$key'\n" if $key ne 'timeout';
    }

    $self->{name} = $name;
    $self->{peer} = {_parse_socket($socket), %args};
}

sub _parse_socket {
    my $socket = shift;
    return (path => $1) if $socket =~ m{^unix:(.+)} || $socket =~ m{^(/.+)};

    $socket =~ s/^inet6?://;
    return (host => '127.0.0.1', port => $socket) if $socket =~ /^\d+$/;
    return (host => $1, port => $2) if $socket =~ /^\[(.+)\]:(\d+)$/;
    return (host => $1, port => $2) if $socket =~ /^(.+):(\d+)$/;
    die "milter: invalid socket '$socket'\n";
}

sub session { $_[0]->connection->notes("milter $_[0]{name}") }

sub message {
    my $self = shift;
    my $txn  = $self->transaction;
    return $txn->notes("milter $self->{name}")
      || $txn->notes("milter $self->{name}", {});
}

sub milter {
    my $self    = shift;
    my $session = $self->session or return;
    return if $session->{accepted};
    return if $self->message->{accepted};
    return $session->{milter};
}

sub hook_connect {
    my ($self, $transaction) = @_;

    my $conn = $self->connection;
    my $milter = eval {
        Qpsmtpd::Milter->new(%{$self->{peer}})->negotiate;
    };
    if (!$milter) {
        chomp(my $err = $@);
        $self->log(LOGERROR, "skip, $self->{name}: $err");
        return DECLINED;
    }
    $self->connection->notes("milter $self->{name}", {milter => $milter});
    $self->log(LOGDEBUG,
               sprintf('%s negotiated v%d, actions 0x%x, protocol 0x%x',
                       $self->{name}, $milter->version, $milter->actions,
                       $milter->protocol));

    my $ip   = $conn->remote_ip;
    my $host = $conn->remote_host;
    $host = "[$ip]" if !$host || $host eq 'Unknown';

    return $self->talk(
        sub {
            $milter->macros(
                'C',
                j                => $self->qp->config('me'),
                _                => "$host [$ip]",
                v                => 'qpsmtpd ' . $self->qp->version,
                '{daemon_name}'  => 'qpsmtpd',
                '{daemon_addr}'  => $conn->local_ip,
                '{daemon_port}'  => $conn->local_port,
                '{client_addr}'  => $ip,
                '{client_port}'  => $conn->remote_port,
                '{client_name}'  => $host,
            );
            $milter->connect($host, $ip, $conn->remote_port);
        },
        $self->session
    );
}

sub hook_helo {
    my ($self, $transaction, $host) = @_;
    my $milter = $self->milter or return DECLINED;
    return $self->talk(sub { $milter->helo($host) }, $self->session);
}

sub hook_ehlo { shift->hook_helo(@_) }

sub hook_mail {
    my ($self, $transaction, $sender, %param) = @_;
    my $milter = $self->milter or return DECLINED;

    $self->session->{in_message} = 1;
    return $self->talk(
        sub {
            $milter->macros(
                'M',
                '{mail_addr}'   => $sender->address,
                '{auth_authen}' => $self->qp->{_auth_user},
                '{auth_type}'   => $self->qp->{_auth_mechanism},
            );
            $milter->mail($sender->format, _esmtp_args(%param));
        }
    );
}

sub hook_rcpt {
    my ($self, $transaction, $rcpt, %param) = @_;
    my $milter = $self->milter or return DECLINED;
    return $self->talk(
        sub {
            $milter->macros('R', '{rcpt_addr}' => $rcpt->address);
            $milter->rcpt($rcpt->format, _esmtp_args(%param));
        }
    );
}

sub _esmtp_args {
    my %param = @_;
    return map { uc($_) . (defined $param{$_} ? "=$param{$_}" : '') }
      sort keys %param;
}

sub hook_data {
    my ($self, $transaction) = @_;
    my $milter = $self->milter or return DECLINED;
    return $self->talk(sub { $milter->data });
}

sub hook_data_post {
    my ($self, $transaction) = @_;

    my @steps = (
        (map { my $h = $_; sub { $self->milter->header(@$h) } } $self->headers),
        sub { $self->milter->end_of_headers },
        sub { $self->send_body },
        sub {
            my @replies = $self->milter->end_of_body;
            $self->session->{in_message} = 0;
            $self->modify($transaction, @replies);
            return @replies;
        },
    );
    for my $step (@steps) {
        $self->milter or return DECLINED;
        my ($rc, @msg) = $self->talk($step);
        return $rc, @msg if $rc != DECLINED;
    }
    return DECLINED;
}

sub headers {
    my $self = shift;
    return map { /^([^:]+):[ \t]*(.*?)\n?\z/s ? [$1, $2] : () }
      @{$self->transaction->header->header};
}

sub send_body {
    my $self   = shift;
    my $milter = $self->milter;
    return if !$milter->wants('B');

    my $txn = $self->transaction;
    $txn->body_resetpos;
    my $line = $txn->body_getline;
    $line = $txn->body_getline if defined $line && $line eq "\n";

    my $chunk = '';
    while (defined $line) {
        $line =~ s/\r?\n\z/\r\n/;
        $chunk .= $line;
        $line = $txn->body_getline;
        next if defined $line && length $chunk < Qpsmtpd::Milter::MAX_BODY_CHUNK;

        my @replies = $milter->body($chunk);
        return @replies if @replies && $replies[-1]{cmd} ne 'c';
        $chunk = '';
    }
    return;
}

sub talk {
    my ($self, $send, $scope) = @_;
    $scope ||= $self->message;

    my @replies = eval { $send->() };
    if (my $err = $@) {
        chomp $err;
        $self->log(LOGERROR, "skip, $self->{name}: $err");
        $self->close_milter;
        return DECLINED;
    }
    my $verdict = $replies[-1] or return DECLINED;
    my $cmd     = $verdict->{cmd};

    return DECLINED if $cmd eq 'c' || $cmd eq 's';

    if ($cmd eq 'a') {
        $self->log(LOGINFO, "pass, $self->{name} accepted");
        $scope->{accepted} = 1;
        return DECLINED;
    }
    if ($cmd eq 'd') {
        $self->log(LOGINFO, "$self->{name} will discard the message");
        $scope->{discard} = 1;
        $scope->{accepted} = 1;
        return DECLINED;
    }
    if ($cmd eq 'r') {
        $self->log(LOGINFO, "fail, $self->{name} rejected");
        return DENY;
    }
    if ($cmd eq 't') {
        $self->log(LOGINFO, "fail, $self->{name} tempfailed");
        return DENYSOFT;
    }
    if ($cmd eq 'y') {
        my ($code) = $verdict->{reply} =~ /^([45])\d\d/;
        my @lines = map { s/^\d{3}[ -]//r } split /\r?\n/, $verdict->{reply};
        $self->log(LOGINFO, "fail, $self->{name}: $lines[0]") if $code;
        return DENYSOFT, @lines if $code && $code == 4;
        return DENY,     @lines if $code;
        $self->log(LOGERROR, "$self->{name} sent invalid reply '$verdict->{reply}'");
        return DECLINED;
    }

    # 'f' (connection failure) and '4' (shutdown)
    $self->log(LOGERROR, "fail, $self->{name} is closing the connection");
    $self->close_milter;
    return DENYSOFT_DISCONNECT;
}

sub modify {
    my ($self, $transaction, @replies) = @_;
    my $header = $transaction->header;
    my $body;

    for my $r (@replies) {
        my $cmd = $r->{cmd};
        if ($cmd eq 'h') {
            $header->add($r->{name}, $r->{value});
        }
        elsif ($cmd eq 'i') {
            $header->add($r->{name}, $r->{value}, $r->{index});
        }
        elsif ($cmd eq 'm') {
            my $index = $r->{index} ? $r->{index} - 1 : 0;
            if (length $r->{value}) {
                $header->replace($r->{name}, $r->{value}, $index);
            }
            else {
                $header->delete($r->{name}, $index);
            }
        }
        elsif ($cmd eq 'b') {
            $body .= $r->{body};
        }
        elsif ($cmd eq '+' || $cmd eq '2') {
            my $rcpt = _address($r->{address}) or next;
            $transaction->add_recipient($rcpt);
        }
        elsif ($cmd eq '-') {
            my $rcpt = _address($r->{address}) or next;
            $transaction->remove_recipient($rcpt);
        }
        elsif ($cmd eq 'e') {
            my $sender = _address($r->{address}) or next;
            $transaction->sender($sender);
        }
        elsif ($cmd eq 'q') {
            $self->log(LOGWARN, "$self->{name} quarantined: $r->{reason}");
            $transaction->notes('milter_quarantine', $r->{reason});
        }
    }

    if (defined $body) {
        $body =~ s/\r\n/\n/g;
        $transaction->body_replace($body);
    }
}

sub _address {
    my $addr = shift;
    $addr = "<$addr>" if $addr !~ /^</;
    return Qpsmtpd::Address->new($addr);
}

sub hook_reset_transaction {
    my ($self, $transaction) = @_;
    my $session = $self->session or return DECLINED;
    return DECLINED if !$session->{in_message} || !$session->{milter};

    $session->{in_message} = 0;
    eval { $session->{milter}->abort };
    $self->close_milter if $@;
    return DECLINED;
}

sub hook_queue {
    my ($self, $transaction) = @_;
    my $session = $self->session or return DECLINED;
    return DECLINED if !$session->{discard} && !$self->message->{discard};

    $self->log(LOGINFO, "$self->{name} discarded the message");
    return OK;
}

sub hook_disconnect {
    my $self = shift;
    $self->close_milter;
    return DECLINED;
}

sub close_milter {
    my $self    = shift;
    my $session = $self->session or return;
    my $milter  = delete $session->{milter} or return;
    $milter->quit;
}
