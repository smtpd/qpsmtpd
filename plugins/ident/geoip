use strict;
use warnings;

use Qpsmtpd::Constants;

#use GeoIP2;      # eval'ed in register()
#use Math::Trig;  # eval'ed in set_distance
#use GeoIP2::WebService::Client; #eval'd in set_distance

sub register {
    my ($self, $qp, @args) = @_;

    $self->log(LOGERROR, "Bad arguments") if @args % 2;
    $self->{_args} = {@args};
    $self->{_args}{db_dir} ||= '/usr/share/GeoIP';

    $self->load_geoip() or return;
    my $enabled = $self->{_args}{add_headers};
    $enabled = 'true' if ! defined $enabled;
    return if $enabled =~ /false/i;
    $self->register_hook( data_post => 'add_headers' );
}

sub load_geoip {
    my ( $self ) = @_;
    eval 'use GeoIP2::Database::Reader';
    if ($@) {
        $self->log(LOGERROR, "could not load GeoIP2");
        return 0;
    }

    eval {
        $self->{_geoip2_asn} = GeoIP2::Database::Reader->new(
            file => $self->{_args}{db_dir} . '/GeoLite2-ASN.mmdb',
        );
    };
    if ($@) {
        $self->log(LOGERROR, "unable to load GeoLite2-ASN.mmdb");
    }

    eval {
        $self->{_geoip2_city} = GeoIP2::Database::Reader->new(
            file => $self->{_args}{db_dir} . '/GeoLite2-City.mmdb',
        );
    };
    if ($@) {
        $self->log(LOGERROR, "unable to load GeoLite2-City.mmdb");
    }

    eval {
        $self->{_geoip2_country} = GeoIP2::Database::Reader->new(
            file => $self->{_args}{db_dir} . '/GeoLite2-Country.mmdb',
        );
    };
    if ($@) {
        $self->log(LOGERROR, "unable to load GeoLite2-Country.mmdb");
    }

    # Get my location if calculating distance
    if ( ! $self->{_my_location} and $self->{_geoip2_city} and (my $ip = $self->{_args}{distance})) {
        my $city_rec;
        eval { $city_rec = $self->{_geoip2_city}->city(ip => $ip); };
        if ($@) {
            $self->log(LOGNOTICE, "no city record for my location");
        } elsif ($city_rec) {
            eval 'use GeoIP2::WebService::Client';
            if ($@) {
                $self->log(LOGERROR,
                           "can't calculate distance, GeoIP2::WebService::Client not installed");
            } else {
                my $loc = $city_rec->location();
                $self->log(LOGNOTICE, sprintf("my location: lat %.4f, lon %.4f", $loc->latitude(), $loc->longitude()));
                $self->{_my_location} = $loc;
            }
        }
    }

    if ($self->{_geoip2_asn} || $self->{_geoip2_city} || $self->{_geoip2_country}) {
        $self->register_hook('connect', 'geoip2_lookup');
        return 1;
    }

    return 0;
}

sub add_headers {
    my ( $self, $txn ) = @_;
    my $ghdr = "";
    for my $h (qw( City Country Continent ASN Distance)) {
        my $note = lc "geoip_$h";
        if ($self->connection->notes($note)) {
        #   $txn->header->delete("X-GeoIP-$h");
        #   $txn->header->add( "X-GeoIP-$h", $self->connection->notes($note), 0 );
            $ghdr .= ", " . $self->connection->notes($note);
        } else {
            $ghdr .= ", -";
        }
    }
    $txn->header->add( "X-GeoIP", substr($ghdr, 2), 0 ) if (length($ghdr) > 2);
    return DECLINED;
}

sub geoip2_lookup {
    my $self = shift;

    my $ip = $self->qp->connection->remote_ip;
    return DECLINED if $self->is_localhost($ip);

    my @msg_parts;
    my $asn;

    if ($self->{_geoip2_asn}) {
        my $asn_rec;
        eval { $asn_rec = $self->{_geoip2_asn}->asn(ip => $ip); };
        if ($@) {
            $self->log(LOGNOTICE, $@);
        } elsif ($asn_rec) {
            $self->qp->connection->notes('geoip_asn', $asn = 'AS' . $asn_rec->autonomous_system_number());
            $self->qp->connection->notes('geoip_organization', $asn_rec->autonomous_system_organization());
#           $self->qp->connection->notes('geoip_isp', $asn_rec->isp()); # not in the asn database
        }
    }
    if ($self->{_geoip2_city}) {
        my $city_rec;
        eval { $city_rec = $self->{_geoip2_city}->city(ip => $ip); };
        if ($@) {
            $self->log(LOGNOTICE, $@);
            return DECLINED;
        } elsif ($city_rec) {
            $self->qp->connection->notes('geoip_country', my $iso_code = $city_rec->country->iso_code());
            $self->qp->connection->notes('geoip_country_name', $city_rec->country->name());
            $self->qp->connection->notes('geoip_continent', my $cont_code = $city_rec->continent->code());
            $self->qp->connection->notes('geoip_city', my $city = $city_rec->city->name());
            $self->qp->connection->notes('geoip_asn', $asn = 'AS' . $city_rec->traits->autonomous_system_number()) unless $asn;
            my $loc = $city_rec->location();
            my $distance = $self->set_distance($loc, $self->{_my_location}) if ($loc and $self->{_my_location});
            $self->qp->connection->notes('geoip_distance', $distance) if $distance;
            push @msg_parts, $cont_code if $cont_code;
            push @msg_parts, $iso_code  if $iso_code;
            push @msg_parts, $city      if $city;
            push @msg_parts, $asn       if $asn;
            push @msg_parts, $distance  if $distance;
            $self->log(LOGINFO, join(", ", @msg_parts));
            return DECLINED;
        }
    }

    if ($self->{_geoip2_country}) {
        my $country_rec;
        eval { $country_rec = $self->{_geoip2_country}->country(ip => $ip); };
        if ($@) {
            $self->log(LOGNOTICE, $@);
            return DECLINED;
        } elsif ($country_rec) {
            $self->qp->connection->notes('geoip_country', my $iso_code = $country_rec->country->iso_code());
            $self->qp->connection->notes('geoip_country_name', $country_rec->country->name());
            $self->qp->connection->notes('geoip_continent', my $cont_code = $country_rec->continent->code());
            push @msg_parts, $cont_code if $cont_code;
            push @msg_parts, $iso_code  if $iso_code;
            push @msg_parts, $asn       if $asn;
            $self->log(LOGINFO, join(", ", @msg_parts));
        }
    }

    return DECLINED;
}

sub set_distance {
    my ($self, $loc, $myloc) = @_;

    eval 'use Math::Trig qw(great_circle_distance deg2rad)';
    if ($@) {
        $self->log(LOGERROR,
                   "can't calculate distance, Math::Trig not installed");
        return;
    }

    # Notice the 90 - latitude: phi zero is at the North Pole.
    sub NESW { deg2rad($_[0]), deg2rad(90 - $_[1]) }
    my @me     = NESW($myloc->longitude(), $myloc->latitude());
    my @sender = NESW($loc->longitude(),   $loc->latitude());
    my $km = great_circle_distance(@me, @sender, 6378);
    $km = sprintf("%.0f", $km);
    return $km . "km";
}
